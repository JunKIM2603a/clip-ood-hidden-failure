# Frozen bootstrap versions for the pilot environment.
CONDA_ENV_NAME=clip-ood
PYTHON_VERSION=3.10

# PyTorch official wheel combination.
TORCH_VERSION=2.9.1
TORCHVISION_VERSION=0.24.1
TORCH_CUDA=cu126

# Third-party research code.
OPENOOD_REPO=https://github.com/PolyU-VCLab/OpenOOD-VLM.git
OPENOOD_COMMIT=48b023365b68b54c87f84ab508de8a3222335985
OPENAI_CLIP_REPO=https://github.com/openai/CLIP.git
OPENAI_CLIP_COMMIT=d05afc436d78f1c48dc0dbf8e5980a9d471f35f6

# Compatibility pins for OpenOOD's eager imports.
NUMPY_VERSION=1.26.4
CYTHON_VERSION=0.29.37
LIBMR_VERSION=0.1.9
IMGAUG_VERSION=0.4.0
FAISS_CPU_VERSION=1.14.3
