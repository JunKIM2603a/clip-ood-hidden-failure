# Frozen bootstrap versions for the pilot environment.
CONDA_ENV_NAME=clip-ood
PYTHON_VERSION=3.10

# PyTorch official wheel combination.
TORCH_VERSION=2.9.1
TORCHVISION_VERSION=0.24.1
TORCH_CUDA=cu126

# Third-party research code.
OPENOOD_REPO=https://github.com/PolyU-VCLab/OpenOOD-VLM.git
OPENOOD_COMMIT=48b023365b68b54c87f84ab508de8a3222335985
OPENAI_CLIP_REPO=https://github.com/openai/CLIP.git
OPENAI_CLIP_COMMIT=d05afc436d78f1c48dc0dbf8e5980a9d471f35f6

# Compatibility pins for OpenOOD's eager imports.
NUMPY_VERSION=1.26.4
CYTHON_VERSION=0.29.37
LIBMR_VERSION=0.1.9
IMGAUG_VERSION=0.4.0
FAISS_CPU_VERSION=1.14.3
OPEN_CLIP_TORCH_VERSION=3.3.0

# Official baseline repositories used as immutable reference assets.
MCM_REPO=https://github.com/deeplearning-wisc/MCM.git
MCM_COMMIT=ea7130f851e7d462cacd21f0e87a127705700bd9
NEGLABEL_REPO=https://github.com/XueJiang16/NegLabel.git
NEGLABEL_COMMIT=3253db684075b2db47844676eccdfda40d67a573

# Independent text embedding model for semantic-cluster robustness analysis.
SENTENCE_TRANSFORMERS_VERSION=5.1.2
TEXT_CLUSTER_MODEL=sentence-transformers/all-MiniLM-L6-v2
TEXT_CLUSTER_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
